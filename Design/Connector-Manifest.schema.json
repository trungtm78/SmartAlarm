{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartAlarm connector manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "protocol",
    "capabilities",
    "authentication",
    "region_scope",
    "retry_class",
    "schemas",
    "safety_class"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "protocol": {
      "type": "string",
      "enum": [
        "mqtt5",
        "https",
        "cap12",
        "sensorthings",
        "onvif_gateway",
        "ot_gateway",
        "mavlink_gateway",
        "pa_gateway",
        "vendor_sdk"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "authentication": {
      "type": "string",
      "enum": [
        "mtls",
        "oauth2",
        "signed_webhook",
        "gateway_managed"
      ]
    },
    "region_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1
    },
    "retry_class": {
      "type": "string",
      "enum": [
        "idempotent",
        "reconcile_before_retry",
        "never_automatic"
      ]
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1
    },
    "safety_class": {
      "type": "string",
      "enum": [
        "read_only",
        "notification",
        "physical_control"
      ]
    },
    "health_interval_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "outbound_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "physical_profile": {
      "type": "object",
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "regional_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "controller_firmware": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "gateway_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "gateway_firmware": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "license_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "interface_document_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "permission_mode": {
          "enum": [
            "observe_only",
            "approved_control",
            "operator_console_only"
          ]
        },
        "binding_revision": {
          "type": "integer",
          "minimum": 1
        },
        "point_map_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "zone_revision": {
          "type": "integer",
          "minimum": 1
        },
        "cause_effect_revision": {
          "type": "integer",
          "minimum": 1
        },
        "acceptance_scope": {
          "enum": [
            "document_candidate",
            "bench_only",
            "field_accepted"
          ]
        },
        "local_automatic_protection_independent": {
          "const": true
        },
        "llm_actuation_allowed": {
          "const": false
        },
        "generic_relay_bypass_allowed": {
          "const": false
        },
        "capability_contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "enum": [
                  "observe",
                  "notify",
                  "physical_request",
                  "operator_task"
                ]
              },
              "operation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "parameter_schema_ref": {
                "type": "string",
                "format": "uri"
              },
              "authorization_policy_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "local_interlocks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "command_ttl_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "retry_class": {
                "enum": [
                  "idempotent",
                  "reconcile_before_retry",
                  "never_automatic"
                ]
              },
              "feedback_point_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "completion_criterion_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "unknown_outcome_policy": {
                "const": "reconcile_no_blind_retry"
              },
              "manufacturer_permission_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "site_approval_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "fat_evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "sat_evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "capability_id",
              "kind",
              "operation",
              "enabled"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "physical_request"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "parameter_schema_ref",
                    "authorization_policy_ref",
                    "local_interlocks",
                    "command_ttl_seconds",
                    "retry_class",
                    "feedback_point_ids",
                    "completion_criterion_ref",
                    "unknown_outcome_policy",
                    "manufacturer_permission_ref",
                    "site_approval_ref"
                  ],
                  "properties": {
                    "local_interlocks": {
                      "minItems": 1
                    },
                    "feedback_point_ids": {
                      "minItems": 1
                    },
                    "retry_class": {
                      "enum": [
                        "reconcile_before_retry",
                        "never_automatic"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "physical_request"
                    },
                    "enabled": {
                      "const": true
                    }
                  },
                  "required": [
                    "kind",
                    "enabled"
                  ]
                },
                "then": {
                  "required": [
                    "fat_evidence_refs",
                    "sat_evidence_refs"
                  ],
                  "properties": {
                    "fat_evidence_refs": {
                      "minItems": 1
                    },
                    "sat_evidence_refs": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "manufacturer",
        "regional_model",
        "controller_firmware",
        "gateway_model",
        "gateway_firmware",
        "license_refs",
        "interface_document_refs",
        "permission_mode",
        "binding_revision",
        "point_map_digest",
        "zone_revision",
        "cause_effect_revision",
        "acceptance_scope",
        "local_automatic_protection_independent",
        "llm_actuation_allowed",
        "generic_relay_bypass_allowed",
        "capability_contracts"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "permission_mode": {
                "enum": [
                  "observe_only",
                  "operator_console_only"
                ]
              }
            },
            "required": [
              "permission_mode"
            ]
          },
          "then": {
            "properties": {
              "capability_contracts": {
                "items": {
                  "properties": {
                    "kind": {
                      "not": {
                        "const": "physical_request"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "acceptance_scope": {
                "enum": [
                  "document_candidate",
                  "bench_only"
                ]
              }
            },
            "required": [
              "acceptance_scope"
            ]
          },
          "then": {
            "properties": {
              "capability_contracts": {
                "items": {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "physical_request"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "properties": {
                      "enabled": {
                        "const": false
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "x-contract-version": "1.0.0",
  "description": "Baseline 1.0 connector design schema. Validation is not manufacturer permission, certificate, exact-configuration site acceptance or permission to operate.",
  "allOf": [
    {
      "if": {
        "properties": {
          "safety_class": {
            "const": "physical_control"
          }
        },
        "required": [
          "safety_class"
        ]
      },
      "then": {
        "required": [
          "physical_profile"
        ],
        "properties": {
          "retry_class": {
            "enum": [
              "reconcile_before_retry",
              "never_automatic"
            ]
          },
          "physical_profile": {
            "properties": {
              "permission_mode": {
                "const": "approved_control"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safety_class": {
            "const": "read_only"
          }
        },
        "required": [
          "safety_class"
        ]
      },
      "then": {
        "properties": {
          "physical_profile": {
            "properties": {
              "permission_mode": {
                "const": "observe_only"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "physical_profile": {
            "properties": {
              "capability_contracts": {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "physical_request"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            },
            "required": [
              "capability_contracts"
            ]
          }
        },
        "required": [
          "physical_profile"
        ]
      },
      "then": {
        "properties": {
          "safety_class": {
            "const": "physical_control"
          }
        }
      }
    }
  ],
  "x-runtime-invariants": [
    "Bind tenant/region/site from verified identity; compare payload and envelope scope.",
    "Resolve exact accepted model/firmware/gateway/license/point-map/cause-effect; observe-only or console-only bindings cannot actuate.",
    "Match expected_version and If-Match, active revisions, source freshness and signed target/parameter approval digest.",
    "Resolve parameters against approved capability schema and units; enforce expires_at against current server time and capability TTL.",
    "Recheck local mode, impairment, interlocks and feedback at server and edge. Local protection/manual controls remain autonomous.",
    "No LLM may approve, configure or issue physical commands.",
    "Timeout after send becomes UNKNOWN absent proof; no blind retry; fence old writer and reconcile ledger.",
    "Verify evidence ownership, authenticity, signers and physical completion criterion; schema-valid references are not evidence by themselves.",
    "FAT/SAT must bind actual exact configuration; simulator cannot establish field_accepted.",
    "Point-map IDs/raw addresses must be unique within binding and match accepted unit/type semantics.",
    "If physical_profile exists, top-level capabilities exactly match capability_contracts IDs; no extra undeclared actions.",
    "Resolve all evidence and approval references for the same tenant/site/model/firmware/license/binding; verify signer authority and actual FAT/SAT records.",
    "Protocol writability does not establish an approved actuation capability. Monitoring-only model variants remain observe_only."
  ]
}
